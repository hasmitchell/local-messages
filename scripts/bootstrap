#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$task_root"
if [ "$(uname -s)" != Darwin ] || [ "$(uname -m)" != arm64 ]; then
  echo 'This bootstrap currently targets Apple Silicon macOS.' >&2
  exit 1
fi
mkdir -p .cache/toolchains
task_archive=.cache/toolchains/go1.27.1.darwin-arm64.tar.gz
if [ ! -x .cache/toolchains/go/bin/go ]; then
  curl --fail --location --silent --show-error \
    https://go.dev/dl/go1.27.1.darwin-arm64.tar.gz -o "$task_archive"
  task_actual=$(shasum -a 256 "$task_archive" | cut -d ' ' -f 1)
  task_expected=ee215d57e0ec269c60cc9ceca68e6bda321ba9ee5afe24f4b0988703c2d87d12
  [ "$task_actual" = "$task_expected" ] || { echo 'Go checksum mismatch' >&2; exit 1; }
  tar -xzf "$task_archive" -C .cache/toolchains
fi
./scripts/go mod download

