#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export GOCACHE="$task_root/.cache/go-build"
export GOMODCACHE="$task_root/.cache/go-mod"
export GOPATH="$task_root/.cache/gopath"
export GOTOOLCHAIN=local
if [ -x "$task_root/.cache/toolchains/go/bin/go" ]; then
  exec "$task_root/.cache/toolchains/go/bin/go" "$@"
fi
if command -v go >/dev/null 2>&1; then
  exec go "$@"
fi
echo 'Go 1.27+ is needed. Run ./scripts/bootstrap first.' >&2
exit 1

